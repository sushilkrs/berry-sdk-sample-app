# Copy to .env and fill in. Variables already set in your shell win over this file.

# Hosted BerryDB API (not app.berrydb.io, which is the web app)
BERRYDB_HOST=https://api.berrydb.io
# API key from your BerryDB account (Settings in app.berrydb.io)
BERRYDB_API_KEY=
# Berry database the resumes go into (created by scripts/setup_berry.py)
BERRY_DATABASE=ResumePlaygroundKG
# Berry database holding one merged profile per student
BERRY_PROFILE_DATABASE=StudentProfiles

# APP_PORT=8800
